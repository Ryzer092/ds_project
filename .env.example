# ---------------------------------------------------------------
# Next AI Agent 設定例（アプリ側の設定名。公式SDKの引数名ではありません）
# 実値はこのファイルに書かず、.env.local や公開先の環境変数に設定してください。
# secret（NEXT_PUBLIC_ 以外）はサーバー専用です。
# ---------------------------------------------------------------

# demo: 架空データのみ（キー不要）／ live: 設定済みかつ利用条件を確認した情報源のみ
SEARCH_MODE=demo
APP_ORIGIN=http://localhost:3000
APP_NAME=Next AI Agent
INITIAL_CATEGORY=desks

# Claude（条件抽出・検索語生成のみ）。未設定の場合、demo は簡易解析、live はフォーム検索のみ。
ANTHROPIC_API_KEY=
# 空欄なら claude-opus-5
ANTHROPIC_MODEL=
# low / medium / high
ANTHROPIC_EFFORT=low

# 楽天市場 商品検索API（version:2026-07-01）
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=

# Amazon Creators API（資格情報バージョンは発行された値。3.1/3.2/3.3 に対応）
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_CREDENTIAL_VERSION=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.co.jp

# Supabase（live の認証・保存に必要）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 運用メタデータの書き込みとアカウント削除にだけ使う（利用者データの操作には使わない）
SUPABASE_SERVER_SECRET_KEY=

# Upstash Redis（本番の live では必須。未設定なら有料検索を停止）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 32文字以上のランダム値（例: openssl rand -base64 48）
SESSION_SIGNING_SECRET=
RATE_LIMIT_HASH_SECRET=

# 上限（費用を保証する値ではありません。実単価から計算して調整してください）
MAX_GLOBAL_SEARCHES_PER_DAY=100
MAX_LLM_CALLS_PER_DAY=200
MAX_PROVIDER_CALLS_PER_DAY=1000
PROVIDER_MAX_RPS=1
SEARCH_TIMEOUT_MS=30000
PROVIDER_TIMEOUT_MS=10000
LLM_TIMEOUT_MS=15000
ANON_SEARCHES_PER_MINUTE=5
ANON_SEARCHES_PER_DAY=10
IP_SEARCHES_PER_DAY=40
USER_SEARCHES_PER_DAY=30
EVENTS_PER_MINUTE=30

# 保持期間（画面の説明文と supabase/sql/schedule-retention.sql に合わせる）
WISH_RETENTION_MONTHS=12
OPS_RETENTION_DAYS=30

# ---------------------------------------------------------------
# サービス紹介サイト（docs/marketing-integration.md）
# ---------------------------------------------------------------
# prelaunch / demo / live（実際の接続状態より進んだ表示にはならない）
MARKETING_PRODUCT_STATUS=
# デモの入口。同一プロジェクトなら /app。別ドメインにする場合は確定した https の実URL
MARKETING_DEMO_URL=
# デモの初回入力〜候補表示を確認したら true（false で「デモ準備中」）
MARKETING_DEMO_READY=
# 未提供の掲載先は空欄のまま（リンクを表示しない）
MARKETING_PRIVACY_URL=
MARKETING_TERMS_URL=
MARKETING_CONTACT_URL=
# 公開ドメイン確定後に設定（https のみ）。両方が揃うまで noindex
SITE_URL=
MARKETING_INDEXABLE=false
